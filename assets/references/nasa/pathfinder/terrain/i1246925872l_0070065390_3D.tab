OBJECT                       = TABLE                                         
  INTERCHANGE_FORMAT         = ASCII                                         
  ROW_BYTES                  = 79                                            
  ROWS                       = 63488                                         
  COLUMNS                    = 6                                             
  DESCRIPTION                = "This table contains three-dimensional spatial
                               coordinates of each pixel in an IMP EDR stereo
                               pair. The coordinates are derived from the    
                               Ames Stereo Pipeline, an automated machine    
                               vision algorithm that correlates features     
                               between the left and right images of stereo   
                               pairs to determine their disparity, then      
                               computes their position using the stereo      
                               camera properties. See Stoker et al., Journal 
                               of Geophysical Research 104, E4, Pg 8889-8906,
                               1999 for a description of the algorithm. The  
                               origin of the coordinate system for the values
                               is at the intersection of the camera elevation
                               and azimuth axes.  The x axis is aligned with 
                               the north vector so that +X values are North  
                               of the origin, the Y axis is aligned with the 
                               West vector so that +Y values are West of the 
                               origin, +Z is up."                            
  OBJECT                     = COLUMN                                        
    COLUMN_NUMBER            = 1                                             
    NAME                     = LINE_NUMBER                                   
    DATA_TYPE                = ASCII_INTEGER                                 
    FORMAT                   = "I3"                                          
    BYTES                    = 3                                             
    START_BYTE               = 1                                             
    DESCRIPTION              = "Line number of pixel in left-hand image of   
                               original EDR stereo pair. Line numbers start  
                               at 1 and increase toward the bottom of the    
                               image."                                       
  END_OBJECT                 = COLUMN                                        
  OBJECT                     = COLUMN                                        
    COLUMN_NUMBER            = 2                                             
    NAME                     = SAMPLE_NUMBER                                 
    DATA_TYPE                = ASCII_INTEGER                                 
    FORMAT                   = "I3"                                          
    BYTES                    = 3                                             
    START_BYTE               = 7                                             
    DESCRIPTION              = "Sample number of pixel in left-hand image of 
                               original EDR stereo pair. Sample numbers start
                               at 1 and increase toward the right side of the
                               image."                                       
  END_OBJECT                 = COLUMN                                        
  OBJECT                     = COLUMN                                        
    COLUMN_NUMBER            = 3                                             
    NAME                     = X_COORDINATE                                  
    DATA_TYPE                = ASCII_REAL                                    
    FORMAT                   = "F7.2"                                        
    BYTES                    = 7                                             
    START_BYTE               = 11                                            
    INVALID_CONSTANT         = 0                                             
    DESCRIPTION              = "X coordinate of pixel derived from           
                               three-dimensional model. X, Y, Z coordinates  
                               of (0, 0, 0) indicate that there was no stereo
                               solution for the pixel."                      
  END_OBJECT                 = COLUMN                                        
  OBJECT                     = COLUMN                                        
    COLUMN_NUMBER            = 4                                             
    NAME                     = Y_COORDINATE                                  
    DATA_TYPE                = ASCII_REAL                                    
    FORMAT                   = "F7.2"                                        
    BYTES                    = 7                                             
    START_BYTE               = 19                                            
    INVALID_CONSTANT         = 0                                             
    DESCRIPTION              = "Y coordinate of pixel derived from           
                               three-dimensional model. X, Y, Z coordinates  
                               of (0, 0, 0) indicate that there was no stereo
                               solution for the pixel."                      
  END_OBJECT                 = COLUMN                                        
  OBJECT                     = COLUMN                                        
    COLUMN_NUMBER            = 5                                             
    NAME                     = Z_COORDINATE                                  
    DATA_TYPE                = ASCII_REAL                                    
    FORMAT                   = "F7.2"                                        
    BYTES                    = 7                                             
    START_BYTE               = 27                                            
    INVALID_CONSTANT         = 0                                             
    DESCRIPTION              = "Z coordinate of pixel derived from           
                               three-dimensional model. X, Y, Z coordinates  
                               of (0, 0, 0) indicate that there was no stereo
                               solution for the pixel."                      
  END_OBJECT                 = COLUMN                                        
  OBJECT                     = COLUMN                                        
    COLUMN_NUMBER            = 6                                             
    NAME                     = PIXEL_VALUE                                   
    DATA_TYPE                = ASCII_INTEGER                                 
    FORMAT                   = "I4"                                          
    VALID_MINIMUM            = 0                                             
    VALID_MAXIMUM            = 4095                                          
    BYTES                    = 4                                             
    START_BYTE               = 41                                            
    DESCRIPTION              = "Data value of pixel in left-hand image of    
                               original EDR stereo pair."                    
  END_OBJECT                 = COLUMN                                        
END_OBJECT                   = TABLE                                         
END                                                                          
